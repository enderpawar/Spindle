node_modules/
dist/
.wrangler/

# 인증키는 프록시 환경변수에만 (AGENTS.md 절대 원칙 4)
.dev.vars
*.local

# Android 릴리스 서명 — 키스토어와 비밀번호는 절대 커밋하지 않는다
*.jks
*.keystore
keystore.properties

# Capacitor iOS에서 빌드/동기화 때 다시 생성되는 파일
web/ios/App/App/public/
web/ios/App/DerivedData/
web/ios/App/App.xcodeproj/xcuserdata/
web/ios/App/App.xcworkspace/xcuserdata/

*.log

# fastlane iOS 빌드 산출물 (IPA·dSYM)과 실행 리포트
build/
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/

# App Store Connect API 키(.p8)는 절대 커밋하지 않는다 — GitHub secret으로만 전달한다
*.p8
