# Spindle iOS 릴리스 파이프라인
#
# ⚠ macOS에서만 동작한다. 개발 머신이 Windows이므로 기본 실행 경로는
#   GitHub Actions의 macOS 러너(`.github/workflows/ios-release.yml`)다.
#   사람이 먼저 해야 하는 App Store Connect 준비 절차는 APP_STORE_RELEASE.md에 있다.
#
# 인증: Apple ID 비밀번호가 아니라 App Store Connect API 키(.p8)를 쓴다. 2FA 프롬프트가
#       없어 무인 실행이 되고, 같은 키를 xcodebuild의 클라우드 서명에도 넘겨
#       인증서·프로비저닝 프로파일을 자동 생성시킨다 (fastlane match 저장소 불필요).
#
# 레인:
#   ios beta      — 빌드 후 TestFlight 업로드 (심사 없이 내부 테스터 배포)
#   ios release   — 빌드 후 App Store 업로드. submit:true 를 줘야 심사 제출까지 간다
#   ios metadata  — 바이너리 없이 스토어 등록정보·스크린샷만 갱신
#   ios build     — 로컬 검증용. 서명된 IPA만 만들고 업로드하지 않는다

require "base64"
require "shellwords"
require "tmpdir"

default_platform(:ios)

ROOT             = File.expand_path("..", __dir__)
APP_IDENTIFIER   = "kr.spindle.app"
XCODE_PROJECT    = File.join(ROOT, "web/ios/App/App.xcodeproj")
SCHEME           = "App"
OUTPUT_DIR       = File.join(ROOT, "build/ios")
IPA_NAME         = "Spindle.ipa"
METADATA_PATH    = File.join(ROOT, "fastlane/metadata/ios")
SCREENSHOTS_PATH = File.join(ROOT, "fastlane/screenshots/ios")

# --- 헬퍼 -------------------------------------------------------------------

# 필수 환경변수를 읽는다. 비어 있으면 어떤 secret이 빠졌는지 알려주고 즉시 멈춘다
# (xcodebuild가 한참 뒤에 알 수 없는 서명 오류로 죽는 것보다 낫다).
def env!(name)
  value = ENV[name].to_s.strip
  if value.empty?
    UI.user_error!("환경변수 #{name}이(가) 비어 있다. APP_STORE_RELEASE.md의 GitHub secrets 표를 확인한다.")
  end
  value
end

# base64로 넘어온 .p8 키를 임시 파일로 푼다.
# 파일 경로가 필요한 이유: spaceship(deliver/pilot)뿐 아니라 xcodebuild의
# -authenticationKeyPath에도 같은 키를 넘겨야 클라우드 서명이 동작한다.
def asc_key_filepath
  @asc_key_filepath ||= begin
    key_id = env!("ASC_KEY_ID")
    decoded = Base64.decode64(env!("ASC_KEY_P8_BASE64"))
    unless decoded.include?("BEGIN PRIVATE KEY")
      UI.user_error!("ASC_KEY_P8_BASE64를 디코드한 결과가 .p8 형식이 아니다. base64 인코딩이 줄바꿈 없이 됐는지 확인한다.")
    end
    path = File.join(Dir.mktmpdir("spindle-asc"), "AuthKey_#{key_id}.p8")
    File.write(path, decoded)
    File.chmod(0o600, path)
    path
  end
end

def asc_api_key
  @asc_api_key ||= app_store_connect_api_key(
    key_id: env!("ASC_KEY_ID"),
    issuer_id: env!("ASC_ISSUER_ID"),
    key_filepath: asc_key_filepath,
    duration: 1200,
    in_house: false,
  )
end

# 저장소 루트에서 명령을 실행한다 (fastlane의 sh는 기본적으로 fastlane/ 안에서 돈다).
def run_in_root(command)
  sh("cd #{ROOT.shellescape} && #{command}")
end

# 웹 자산을 빌드해 네이티브 셸에 복사한다.
# `npm run app:sync:ios`(루트 package.json) = build:app + npx cap sync ios.
# web/ios/App/App/public 은 .gitignore 대상이라 이 단계 없이는 빈 WebView가 나온다.
def sync_web_assets
  UI.message("웹 자산을 빌드해 iOS 셸에 동기화한다")
  run_in_root("npm --prefix web ci")
  run_in_root("npm run app:sync:ios")
end

# 빌드 번호(CFBundleVersion) 결정. App Store Connect는 같은 버전 안에서
# 빌드 번호가 항상 증가하기를 요구한다.
#   1) BUILD_NUMBER를 명시했으면 그대로
#   2) TestFlight의 최신 빌드 번호 + 1
#   3) 조회 실패(앱 레코드가 아직 없는 최초 업로드 등) 시 GITHUB_RUN_NUMBER, 없으면 1
def resolve_build_number
  explicit = ENV["BUILD_NUMBER"].to_s.strip
  return explicit unless explicit.empty?

  begin
    latest = latest_testflight_build_number(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0,
    )
    (latest.to_i + 1).to_s
  rescue => e
    fallback = ENV["GITHUB_RUN_NUMBER"].to_s.strip
    fallback = "1" if fallback.empty?
    UI.important("TestFlight 빌드 번호 조회 실패(#{e.message}) — #{fallback}을 쓴다.")
    fallback
  end
end

# MARKETING_VERSION(CFBundleShortVersionString). 스토어에 보이는 버전.
def resolve_marketing_version(options)
  from_option = options[:version].to_s.strip
  return from_option unless from_option.empty?

  from_env = ENV["MARKETING_VERSION"].to_s.strip
  from_env.empty? ? "1.0.0" : from_env
end

# 서명된 App Store용 IPA를 만든다.
def build_ipa(options)
  version = resolve_marketing_version(options)
  build   = resolve_build_number
  team    = env!("APPLE_TEAM_ID")

  UI.important("빌드: 버전 #{version} (#{build})")

  sync_web_assets unless options[:skip_web_sync]

  # -allowProvisioningUpdates + -authenticationKey* 조합이 클라우드 서명이다.
  # 러너에 인증서를 미리 설치하지 않아도 Xcode가 API 키로 배포 인증서와
  # 프로비저닝 프로파일을 발급·갱신한다.
  xcargs = [
    "-allowProvisioningUpdates",
    "-authenticationKeyPath", asc_key_filepath.shellescape,
    "-authenticationKeyID", env!("ASC_KEY_ID").shellescape,
    "-authenticationKeyIssuerID", env!("ASC_ISSUER_ID").shellescape,
    "MARKETING_VERSION=#{version}",
    "CURRENT_PROJECT_VERSION=#{build}",
    "DEVELOPMENT_TEAM=#{team}",
  ].join(" ")

  build_app(
    project: XCODE_PROJECT,
    scheme: SCHEME,
    configuration: "Release",
    export_method: "app-store",
    output_directory: OUTPUT_DIR,
    output_name: IPA_NAME,
    clean: true,
    include_symbols: true,
    include_bitcode: false,
    xcargs: xcargs,
    export_options: {
      teamID: team,
      signingStyle: "automatic",
      uploadSymbols: true,
      manageAppVersionAndBuildNumber: false,
    },
  )

  lane_context[SharedValues::IPA_OUTPUT_PATH]
end

# 스크린샷 디렉터리가 비어 있으면 deliver가 "스크린샷 0장"으로 해석해
# 스토어에 올라가 있던 것을 지운다. 비었을 때는 아예 건드리지 않는다.
def screenshots_ready?
  Dir.glob(File.join(SCREENSHOTS_PATH, "*", "*.png")).any?
end

# --- 레인 -------------------------------------------------------------------

platform :ios do
  desc "서명된 App Store용 IPA만 만든다 (업로드 없음). 파이프라인 점검용."
  lane :build do |options|
    ipa = build_ipa(options)
    UI.success("IPA 생성 완료: #{ipa}")
  end

  desc "빌드 후 TestFlight에 업로드한다. 심사 없이 내부 테스터에게 바로 배포된다."
  lane :beta do |options|
    ipa = build_ipa(options)

    upload_to_testflight(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      ipa: ipa,
      # 처리 완료까지 기다리지 않는다 (러너 시간 절약). 처리 상태는
      # App Store Connect의 TestFlight 화면에서 확인한다.
      skip_waiting_for_build_processing: true,
      # 외부 테스터 그룹은 베타 심사를 거쳐야 하므로 자동 배포하지 않는다.
      distribute_external: false,
      notify_external_testers: false,
    )

    UI.success("TestFlight 업로드 완료. 처리에 보통 5~15분 걸린다.")
  end

  desc "빌드 후 App Store에 업로드한다. submit:true 를 줘야 심사 제출까지 진행한다."
  lane :release do |options|
    submit = options[:submit].to_s == "true"
    ipa = build_ipa(options)

    unless screenshots_ready?
      UI.important("#{SCREENSHOTS_PATH}에 스크린샷이 없다 — 스크린샷 업로드를 건너뛴다.")
      UI.important("생성 방법은 APP_STORE_RELEASE.md의 스크린샷 절 참고.")
    end

    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      ipa: ipa,
      metadata_path: METADATA_PATH,
      screenshots_path: SCREENSHOTS_PATH,
      skip_screenshots: !screenshots_ready?,
      # HTML 미리보기와 확인 프롬프트를 건너뛴다 (CI에는 사람이 없다).
      force: true,
      # 심사 제출은 명시적으로 요청했을 때만. 사고로 제출되면 되돌리기 번거롭다.
      submit_for_review: submit,
      # 승인돼도 자동 공개하지 않는다 — 공개 시점은 사람이 정한다.
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        # 광고 식별자(IDFA)를 쓰지 않는다. 앱에 광고·트래킹 SDK가 없다.
        add_id_info_uses_idfa: false,
        # Info.plist의 ITSAppUsesNonExemptEncryption=false와 일치시킨다.
        export_compliance_uses_encryption: false,
        # 관광공사 API 콘텐츠를 쓰지만 공공데이터 이용 조건을 따르므로 권리를 보유한다.
        content_rights_contains_third_party_content: true,
        content_rights_has_rights: true,
      },
    )

    if submit
      UI.success("App Store 업로드 + 심사 제출 완료.")
    else
      UI.success("App Store 업로드 완료. 심사 제출은 App Store Connect에서 직접 하거나 submit:true로 다시 실행한다.")
    end
  end

  desc "바이너리 없이 스토어 등록정보와 스크린샷만 갱신한다."
  lane :metadata do
    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      metadata_path: METADATA_PATH,
      screenshots_path: SCREENSHOTS_PATH,
      skip_binary_upload: true,
      skip_screenshots: !screenshots_ready?,
      force: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false,
    )

    UI.success("스토어 등록정보 갱신 완료.")
  end
end
